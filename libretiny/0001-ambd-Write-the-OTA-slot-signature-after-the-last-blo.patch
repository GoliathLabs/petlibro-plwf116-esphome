From 76a0c9ad497adcbf6a7491b60fba7cca2684e137 Mon Sep 17 00:00:00 2001
From: GoliathLabs <git@xdfr.de>
Date: Wed, 4 Nov 2026 01:13:41 +0100
Subject: [PATCH 1/3] [ambd] Write the OTA slot signature after the last block

The UF2 image carried a valid slot signature in its first block. An update
that stopped early left a half-written slot that the bootloader would boot.

The device image now has a blank signature. lt_ota_switch() accepts a
complete unsigned slot, and lt_ota_dual_switch_flag() writes the signature
at the end. The flasher image keeps its signature.

Assisted-by: Claude Code (claude-opus-5-5)
---
 builder/family/realtek-ambd.py       | 13 ++++++++---
 cores/realtek-ambd/base/api/lt_ota.c | 33 +++++++++++++++++++++++++---
 2 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/builder/family/realtek-ambd.py b/builder/family/realtek-ambd.py
index 4ca17f9..1794ed9 100644
--- a/builder/family/realtek-ambd.py
+++ b/builder/family/realtek-ambd.py
@@ -306,17 +306,24 @@ def build_ota_image(target, source, env):
 
     with open(str(target[0]), "wb") as f:
         f.write(image)
+    # OTA (device) copy with a blank slot signature: the bootloader picks a slot
+    # by its signature, so it must only become valid once the whole image is
+    # written. lt_ota_dual_switch_flag() writes it after the last block.
+    with open(str(target[1]), "wb") as f:
+        f.write(b"\xff" * len(IMG2_SIGN) + image[len(IMG2_SIGN) :])
 
 
 image_ota = "${BUILD_DIR}/image_ota.${FLASH_OTA1_OFFSET}.bin"
+image_ota_unsigned = "${BUILD_DIR}/image_ota_unsigned.${FLASH_OTA1_OFFSET}.bin"
 env.Command(
-    image_ota,
+    [image_ota, image_ota_unsigned],
     "${BUILD_DIR}/${PROGNAME}.elf",
     env.VerboseAction(build_ota_image, "Packing $TARGET"),
 )
-env.Depends("${BUILD_DIR}/firmware.uf2", image_ota)
+env.Depends("${BUILD_DIR}/firmware.uf2", [image_ota, image_ota_unsigned])
 env.Replace(
     UF2OTA=[
-        f"{image_ota},{image_ota}=device:ota1,ota2;flasher:ota1,ota2",
+        f"{image_ota_unsigned},{image_ota_unsigned}=device:ota1,ota2",
+        f"{image_ota},{image_ota}=flasher:ota1,ota2",
     ],
 )
diff --git a/cores/realtek-ambd/base/api/lt_ota.c b/cores/realtek-ambd/base/api/lt_ota.c
index 67c9b7c..bd00e78 100644
--- a/cores/realtek-ambd/base/api/lt_ota.c
+++ b/cores/realtek-ambd/base/api/lt_ota.c
@@ -10,6 +10,8 @@
 #define AMBD_OTA_SIGN_0 0x35393138 // "8195"
 #define AMBD_OTA_SIGN_1 0x31313738 // "8711"
 
+static bool lt_ota_has_unsigned_image(uint8_t index);
+
 lt_ota_type_t lt_ota_get_type() {
 	return OTA_TYPE_DUAL;
 }
@@ -74,8 +76,17 @@ bool lt_ota_dual_switch_flag() {
 	uint32_t tgt_off = target == 2 ? FLASH_OTA2_OFFSET : FLASH_OTA1_OFFSET;
 	uint32_t old_off = target == 2 ? FLASH_OTA1_OFFSET : FLASH_OTA2_OFFSET;
 	if (!lt_ota_is_valid(target)) {
-		// The update did not carry the signature: write it.
-		FLASH_EreaseDwordsXIP(tgt_off, 2);
+		// The update did not carry the signature (OTA images ship it blank, so a
+		// partly written slot never boots): write it. Only erase if not blank.
+		uint8_t head[8];
+		if (lt_flash_read(tgt_off, head, 8) != 8)
+			return false;
+		for (uint8_t i = 0; i < 8; i++) {
+			if (head[i] != 0xFF) {
+				FLASH_EreaseDwordsXIP(tgt_off, 2);
+				break;
+			}
+		}
 		FLASH_TxData12BXIP(tgt_off, 8, (u8 *)sig);
 		if (!lt_ota_is_valid(target))
 			return false;
@@ -116,7 +127,23 @@ bool lt_ota_switch(bool revert) {
 	uint8_t stored	= lt_ota_dual_get_stored();
 	if ((current == stored) == revert)
 		return true;
-	if (!lt_ota_is_valid(stored ^ 0b11))
+	if (!lt_ota_is_valid(stored ^ 0b11) && !lt_ota_has_unsigned_image(stored ^ 0b11))
 		return false;
 	return lt_ota_dual_switch_flag();
 }
+
+/**
+ * A slot holding a fully written OTA image whose signature is still blank:
+ * 8 x 0xFF, followed by a plausible first section header (length, address).
+ */
+static bool lt_ota_has_unsigned_image(uint8_t index) {
+	uint32_t offset;
+	if (!lt_ota_dual_get_offset(index, &offset))
+		return false;
+	uint32_t head[4];
+	if (lt_flash_read(offset, (void *)head, sizeof(head)) != sizeof(head))
+		return false;
+	if (head[0] != 0xFFFFFFFF || head[1] != 0xFFFFFFFF)
+		return false;
+	return head[2] != 0 && head[2] != 0xFFFFFFFF && head[3] != 0xFFFFFFFF;
+}
