From a399aa25c56a14a844d17cf20a05e464e23afe15 Mon Sep 17 00:00:00 2001
From: GoliathLabs <git@xdfr.de>
Date: Wed, 4 Nov 2026 01:13:41 +0100
Subject: [PATCH 2/3] [ambd] Add RTL8721DM chip model

The Petlibro PLWF116 uses an RTL8721DM (AmebaD, QFN68, 8 MiB flash).

Assisted-by: Claude Code (claude-opus-5-5)
---
 cores/common/base/lt_types.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/cores/common/base/lt_types.h b/cores/common/base/lt_types.h
index 6ea1ef1..9387ad5 100644
--- a/cores/common/base/lt_types.h
+++ b/cores/common/base/lt_types.h
@@ -43,6 +43,7 @@ typedef enum {
 	// Realtek AmebaD
 	RTL8720DN = CPU_MODEL(F_RTL8720D, 0xE0), // TODO(bench): confirm chip id from EFUSE
 	RTL8720DM = CPU_MODEL(F_RTL8720D, 0xE1), // TODO(bench): confirm chip id from EFUSE
+	RTL8721DM = CPU_MODEL(F_RTL8720D, 0xE2), // TODO(bench): confirm chip id from EFUSE
 	// Beken 72XX
 	BK7231Q = CPU_MODEL(F_BK7231Q, 0x31), // *SCTRL_CHIP_ID = 0x7231
 	BK7231T = CPU_MODEL(F_BK7231T, 0x1A), // *SCTRL_CHIP_ID = 0x7231a
